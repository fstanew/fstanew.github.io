<!DOCTYPE html>
<html>
<head>
  <title>Edit Car</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container">
      <span class="navbar-brand mb-0 h1">Moje Auta</span>
    </div>
  </nav>
  <div class="container bg-white p-4 rounded shadow-sm" style="max-width: 600px;">
    <h1>Edit Car</h1>
    <form action="/car/<%= car.id %>/edit" method="POST" class="mt-4">
      <div class="mb-3">
        <label class="form-label">Subject</label>
        <input type="text" name="subject" class="form-control" value="<%= car.subject %>" required>
      </div>
      <div class="mb-3">
        <label class="form-label">Content</label>
        <textarea name="content" class="form-control" rows="3" required><%= car.content %></textarea>
      </div>
      <button type="submit" class="btn btn-success">Update</button>
      <a href="/car" class="btn btn-link">back to list</a>
    </form>
    <form action="/car/<%= car.id %>/delete" method="POST" class="mt-2" onsubmit="return confirm('Are you sure?');">
      <button class="btn btn-danger">Delete</button>
    </form>
  </div>
</body>
</html>
