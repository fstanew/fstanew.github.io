<!DOCTYPE html>
<html>
<head>
  <title>Car index</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container">
      <span class="navbar-brand mb-0 h1">Moje Auta</span>
    </div>
  </nav>
  <div class="container bg-white p-4 rounded shadow-sm">
    <h1>Car index</h1>
    <table class="table table-striped mt-3">
      <thead>
        <tr>
          <th>Id</th>
          <th>Subject</th>
          <th>Content</th>
          <th>actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (cars.length > 0) { %>
          <% cars.forEach(function(car) { %>
            <tr>
              <td><%= car.id %></td>
              <td><%= car.subject %></td>
              <td><%= car.content %></td>
              <td>
                <a href="/car/<%= car.id %>" class="btn btn-sm btn-info">show</a>
                <a href="/car/<%= car.id %>/edit" class="btn btn-sm btn-warning">edit</a>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="4" class="text-center">no records found</td>
          </tr>
        <% } %>
      </tbody>
    </table>
    <a href="/car/new" class="btn btn-success">Create new</a>
  </div>
</body>
</html>
