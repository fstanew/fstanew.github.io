<!DOCTYPE html>
<html>
<head>
  <title>Car</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container">
      <span class="navbar-brand mb-0 h1">Moje Auta</span>
    </div>
  </nav>
  <div class="container bg-white p-4 rounded shadow-sm">
    <h1>Car</h1>
    <table class="table mt-4">
      <tbody>
        <tr>
          <th>Id</th>
          <td><%= car.id %></td>
        </tr>
        <tr>
          <th>Subject</th>
          <td><%= car.subject %></td>
        </tr>
        <tr>
          <th>Content</th>
          <td><%= car.content %></td>
        </tr>
      </tbody>
    </table>
    <div class="d-flex gap-2">
      <a href="/car" class="btn btn-secondary">back to list</a>
      <a href="/car/<%= car.id %>/edit" class="btn btn-warning">edit</a>
      <form action="/car/<%= car.id %>/delete" method="POST" onsubmit="return confirm('Are you sure?');">
        <button class="btn btn-danger">Delete</button>
      </form>
    </div>
  </div>
</body>
</html>
